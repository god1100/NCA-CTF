# ============================================================
# NCA Batch 4 Private CTF — Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.

# --------------------------------------------------------
# Application
# --------------------------------------------------------
APP_NAME="NCA Batch 4 CTF"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# --------------------------------------------------------
# Database
# (Not used yet in Phase 0 — reserved for Phase 1)
# --------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nca_ctf
DB_USERNAME=nca_ctf_app
DB_PASSWORD=

# --------------------------------------------------------
# Session / Security
# (Not used yet — reserved for Phase 2 authentication)
# --------------------------------------------------------
APP_SECRET=

# --------------------------------------------------------
# Docker / Challenge Infrastructure
# (Not used yet — reserved for Phase 8)
# --------------------------------------------------------
DOCKER_HOST=

# --------------------------------------------------------
# Rate limiting
# (Not used yet — reserved for later phases)
# --------------------------------------------------------
RATE_LIMIT_ENABLED=true
