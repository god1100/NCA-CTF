# ============================================================
# NCA Batch 4 Private CTF — Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.

# --------------------------------------------------------
# Application
# --------------------------------------------------------
APP_NAME="NCA Batch 4 CTF"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# --------------------------------------------------------
# Database (Phase 1)
# --------------------------------------------------------
# Use a dedicated application database user — never the DB root account.
# See docs/ctf4.txt §39.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nca_ctf
DB_USERNAME=nca_ctf_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --------------------------------------------------------
# Development-only seed admin (Phase 1 seeding)
# Leave unset to skip creating a dev admin account entirely.
# NEVER set these in a production .env.
# --------------------------------------------------------
DEV_SEED_ADMIN_USERNAME=
DEV_SEED_ADMIN_EMAIL=
DEV_SEED_ADMIN_PASSWORD=

# --------------------------------------------------------
# Session / Security (Phase 2)
# --------------------------------------------------------
# Used as the HMAC key for hashing IPs/identifiers before storage, and as
# the CSRF token signing secret. Generate a long random value per
# environment -- never reuse this placeholder.
APP_SECRET=

SESSION_LIFETIME_SECONDS=7200

# --------------------------------------------------------
# Authentication rate limiting (Phase 2)
# --------------------------------------------------------
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --------------------------------------------------------
# Team invitations (Phase 3)
# team_min_size / team_max_size live in the system_settings table (seeded
# in Phase 1), NOT here -- this is only the invitation link lifetime,
# which has no equivalent row in system_settings.
# --------------------------------------------------------
TEAM_INVITATION_TTL_HOURS=72

# --------------------------------------------------------
# Docker / Challenge Infrastructure
# (Not used yet — reserved for Phase 8)
# --------------------------------------------------------
DOCKER_HOST=

# --------------------------------------------------------
# Rate limiting
# (Not used yet — reserved for later phases)
# --------------------------------------------------------
RATE_LIMIT_ENABLED=true
